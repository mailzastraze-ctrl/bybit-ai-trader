# Railway → service → Variables. Never commit real values.
BYBIT_API_KEY=            # Bybit DEMO trading API key (created in Demo Trading mode)
BYBIT_API_SECRET=
WEB_USER=admin
WEB_PASSWORD=             # password for the web terminal (basic auth)
RAILWAY_RUN_UID=0         # volumes are mounted as root
# Optional tuning
RESEARCH_EPOCHS=120       # hyperopt epochs per walk-forward fold
RESEARCH_JOBS=2           # parallel hyperopt workers (≈ vCPUs to use)
RESEARCH_IDLE_SECONDS=300 # pause between experiments (controls CPU cost)
RESEARCH_ENABLED=1
AITRADER_PROFILE=        # "lite" for ~1 GB RAM instances (Railway trial)
AITRADER_LEVERAGE=3
